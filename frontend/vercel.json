{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mobilaviva-1205413489.fly.dev/api/:path*" },
    { "source": "/img/:path*", "destination": "https://mobilaviva-1205413489.fly.dev/img/:path*" },
    { "source": "/robots.txt", "destination": "https://mobilaviva-1205413489.fly.dev/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://mobilaviva-1205413489.fly.dev/sitemap.xml" },
    { "source": "/llms.txt", "destination": "https://mobilaviva-1205413489.fly.dev/llms.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
